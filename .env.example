# Anthropic API key for the LLM-based poker agent
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Claude model to use (default: claude-sonnet-4-5)
# Options: claude-sonnet-4-5, claude-opus-4-6, claude-haiku-4-5
# POKER_BOT_MODEL=claude-sonnet-4-5

# Logging level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
# POKER_BOT_LOG_LEVEL=INFO

# Log file path (default: stderr only)
# POKER_BOT_LOG_FILE=poker_bot.log

# Trace output directory (default: traces)
# POKER_BOT_TRACE_DIR=traces

# SQLite database path for persistent memory (default: poker_bot.db)
# POKER_BOT_DB_PATH=poker_bot.db
